ent-ActionPumpkinCultOpenShop = [color=orange]Открыть Магазин[/color]
    .desc = Откройте доступ к потусторонним способностям тыквиума.

ent-ActionStunGrab = [color=orange]Ошеломляющая Хватка[/color]
    .desc = Сбейте цель с ног.

ent-ActionStunGrabTwo = [color=orange]Ошеломляющая Хватка 2[/color]
    .desc = Сбейте цель с ног. Теперь без возможности моментально встать.

ent-ActionPumpkinCultRod = [color=red]Запустить Недвижемый Стержень[color]
    .desc = ЗАПУСКАЕТ ЧЕРТОВ НЕДВИЖИМЫЙ СТЕРЖЕНЬ.

ent-ActionPumpkiniteDevour = [color=orange]Поглотить Тыквиум[/color]
    .desc = Поглотите тыквиум, чтобы исцелиться. Учтите, что процесс не мгновенный, и напрямую зависит от кол-ва поглощенных слитков.

ent-ActionCultPumpkinRed = [color=red]Красная Тыковка[/color]
    .desc = Запустите красную тыкву, что несильно взрывается.

ent-ActionCultPumpkinRedTwo = [color=red]Красная Тыковка 2[/color]
    .desc = Запустите красную тыкву, что на этот раз, взрывается с приличной силой.

ent-ActionCultPumpkinGhost = [color=cyan]Призрачная Тыковка[/color]
    .desc = Запустите призрачную тыкву, что проходит сквозь препятствия, сбивает врагов с ног, и охлаждает их.

ent-ActionCultPumpkinGhostTwo = [color=cyan]Призрачная Тыковка 2[/color]
    .desc = Запустите призрачную тыкву, что втягивает врагов по пути следования.

ent-ActionPumpkinCultRobustOffering = [color=darkRed]Потустороннее Предложение[color] 
    .desc = Получите силу, но какой ценой...

ent-ActionPumpkinCultBlindCurse = [color=darkRed]Проклятие Слепоты[color] 
    .desc = Ослепите всех неверных. Перезарядка 120 секунд.

ent-ActionPumpkinCultBlindPacify = [color=darkRed]Проклятие Пацифизма[color] 
    .desc = Заставьте всех неверных сложить свое оружие. Перезарядка 360 секунд.