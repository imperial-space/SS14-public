heretic-rift-desc = Трещина в реальности, излучающая загадочную энергию. Источник знания для тех, кто способен её поглотить.

heretic-breach-name = Брешь в реальности
heretic-breach-desc = Поглощённый разрыв оставил после себя открытую рану в ткани мироздания. Теперь её видят все.

# ─── Брешь: взаимодействия ───────────────────────────
heretic-breach-heretic-examine-1 = [purplepulse]Брешь пульсирует в такт биению вашего сердца. Мансус смотрит сквозь неё.[/purplepulse]
heretic-breach-heretic-examine-2 = [purplepulse]Через эту дыру вы ощущаете холодное присутствие Мансуса — наблюдающего, ждущего.[/purplepulse]
heretic-breach-heretic-examine-3 = [purplepulse]Ткань реальности истончена здесь почти до нуля. Ваша работа.[/purplepulse]
heretic-breach-heretic-examine-4 = [purplepulse]Потусторонние голоса шёпотом произносят ваше имя сквозь разрыв.[/purplepulse]
heretic-breach-heretic-examine-5 = [purplepulse]Запах озона и пепла — запах распадающейся реальности. Вы это создали.[/purplepulse]
heretic-breach-heretic-examine-6 = [purplepulse]Брешь тянется к вам, как живое существо. Она вас узнаёт.[/purplepulse]

heretic-breach-heretic-interact = [purplepulse]Вам лучше не искушать неподвластные вам силы![/purplepulse]

