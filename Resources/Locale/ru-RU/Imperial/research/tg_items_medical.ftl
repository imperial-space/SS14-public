imperial-med-report-temp = Температура тела: { $temp } °C
imperial-med-report-chems = Посторонние реагенты в крови:
imperial-med-state-alive = жив
imperial-med-state-critical = критическое
imperial-med-state-dead = мёртв
imperial-med-state-invalid = неизвестно

# Вскрытие
imperial-autopsy-alive = Вскрытие можно проводить только на трупе.
imperial-autopsy-done = Отчёт о вскрытии распечатан.
imperial-autopsy-header = [head=2]Отчёт о вскрытии[/head]

# Химический анализатор
imperial-ph-solution = Раствор: { $volume }/{ $max } ед., { $temp } °C
