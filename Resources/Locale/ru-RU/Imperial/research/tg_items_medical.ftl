# Дисплеи
imperial-vitals-no-patient = Пациента рядом нет.

# Рефиллер
imperial-refiller-done = Медипен заправлен.
imperial-refiller-no-reagents = В баке нет нужных реагентов.

# Хроматограф
imperial-hplc-verb = { $reagent } ({ $amount } ед.)
imperial-hplc-full = Правый стакан полон.
imperial-hplc-done = Перенесено { $amount } ед.

# Дым-машина
imperial-smoke-on = Включить дым-машину
