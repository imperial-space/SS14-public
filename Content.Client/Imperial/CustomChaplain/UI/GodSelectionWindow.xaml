<DefaultWindow
    SetSize="600 400"
    Title="{Loc 'god-selection-window-title'}"
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <BoxContainer
        Margin="15"
        Orientation="Vertical"
        SeparationOverride="10">

        <!--  Title  -->
        <Label
            HorizontalAlignment="Center"
            Margin="0,10,0,20"
            StyleClasses="LabelHeading"
            Text="{Loc 'god-selection-window-description'}" />

        <!--  Predefined Gods Section  -->
        <BoxContainer Orientation="Vertical" SeparationOverride="5">
            <Label
                Margin="0,0,0,5"
                StyleClasses="LabelSubText"
                Text="{Loc 'god-selection-predefined-label'}" />
            <OptionButton
                HorizontalExpand="True"
                MinHeight="35"
                Name="PredefinedGodsDropdown" />
        </BoxContainer>

        <!--  Custom God Section  -->
        <BoxContainer Orientation="Vertical" SeparationOverride="5">
            <Label
                Margin="0,0,0,5"
                StyleClasses="LabelSubText"
                Text="{Loc 'god-selection-custom-label'}" />
            <BoxContainer Orientation="Horizontal" SeparationOverride="10">
                <LineEdit
                    HorizontalExpand="True"
                    MinHeight="35"
                    Name="CustomGodTextBox"
                    PlaceHolder="{Loc 'god-selection-custom-placeholder'}" />
                <Button
                    MinHeight="35"
                    Name="CustomGodButton"
                    Text="{Loc 'god-selection-create-button'}" />
            </BoxContainer>
        </BoxContainer>

        <!--  Status Text  -->
        <Label
            HorizontalAlignment="Center"
            Margin="0,10,0,0"
            Name="StatusText"
            StyleClasses="LabelSubText"
            Text="{Loc 'god-selection-status-text'}" />

        <!--  Confirm Button  -->
        <controls:ConfirmButton
            ConfirmationText="{Loc god-selection-confirm-final-button}"
            Disabled="True"
            HorizontalExpand="True"
            Margin="0,10,0,0"
            MinHeight="40"
            Name="ConfirmButton"
            Text="{Loc 'god-selection-confirm-button'}" />
    </BoxContainer>
</DefaultWindow>
