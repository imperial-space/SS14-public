<DefaultWindow xmlns="https://spacestation14.io"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               x:Class="Imperial.Medieval.UniversalLock.Lockpick.UniversalLockpickWindow"
               Title="{Loc 'UniversalLockpick-ui-setup-title'}"
               MinWidth="350"
               MinHeight="500">

    <BoxContainer Orientation="Vertical" Margin="5" SeparationOverride="10">

        <Label Name="InfoLabel" Text="Допустимые значения: от 0 до X" HorizontalAlignment="Center"/>

        <ScrollContainer VerticalExpand="True" MinHeight="150" HorizontalExpand="True">
            <BoxContainer Name="InputsContainer" Orientation="Vertical" HorizontalExpand="True" SeparationOverride="8" Margin="5"/>
        </ScrollContainer>

        <Button Name="SetCodeButton" Text="{Loc 'UniversalLockpick-ui-setup-setcodebutton'}" HorizontalAlignment="Center"/>

    </BoxContainer>

</DefaultWindow>